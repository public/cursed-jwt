+/*
+ * include/haproxy/jwt_cursed.h
+ * Signature checks for jwt_verify through cursed-jwt (HS256, RS256, ES256).
+ *
+ * Only the cryptographic check moves: tokenizing, the base64url decoding of
+ * the signature and every status code stay in src/jwt.c, so jwt_verify
+ * returns the same value for every input. Anything this file does not handle
+ * returns JWT_CURSED_FALLBACK and takes HAProxy's OpenSSL path unchanged.
+ *
+ * The glue (src/jwt_cursed.c) is built into libcursedjwt.a with cursed-jwt
+ * itself, whose jwt.h shares HAProxy's jwt_ prefix.
+ *
+ * Part of cursed-jwt's contrib/haproxy (https://github.com/public/cursed-jwt).
+ */
+#ifndef _HAPROXY_JWT_CURSED_H
+#define _HAPROXY_JWT_CURSED_H
+
+#include <haproxy/api.h>
+#include <haproxy/base64.h>
+
+/* the files that include this header get the cursed paths */
+#define USE_CURSED_JWT 1
+
+#ifdef USE_CURSED_JWT
+#include <stddef.h>
+#include <openssl/evp.h>
+
+#define JWT_CURSED_FALLBACK -1
+
+/* 0 disables the cursed paths (global "jwt.cursed off", and the unit tests) */
+extern int jwt_cursed_enabled;
+
+/* HMAC-SHA256 of <msg> under <key>, compared in constant time with the
+ * decoded signature. Returns 1 if they match, 0 otherwise. */
+int jwt_cursed_hs256(const char *key, size_t klen, const char *msg, size_t mlen,
+                     const unsigned char *sig, size_t slen);
+
+/* Per-key state built when the PEM public key is loaded: RSA (2048..4096-bit
+ * modulus, odd e < 2^64) or EC P-256. NULL for anything else. */
+void *jwt_cursed_pkey_new(EVP_PKEY *pkey);
+void jwt_cursed_pkey_free(void *ck);
+
+/* Checks a RS256 (<is_ecdsa> = 0) or ES256 (<is_ecdsa> = 1) signature. Returns
+ * 1 if valid, 0 if not, JWT_CURSED_FALLBACK if the key type does not match the
+ * algorithm or the signature length is not the canonical one, which OpenSSL
+ * then decides. */
+int jwt_cursed_pk_verify(const void *ck, int is_ecdsa, const char *msg, size_t mlen,
+                         const unsigned char *sig, size_t slen);
+
+/* base64url decoding, SIMD. Returns the decoded length, or -1 for anything it
+ * does not take (padding, non-canonical trailing bits, any other byte, too
+ * little room), which base64urldec() then decodes with its own rules. */
+int jwt_cursed_b64url(char *dst, size_t dsz, const char *src, size_t n);
+#endif
+
+/* base64urldec() with the cursed fast path in front. Same results: what the
+ * fast decoder accepts (A-Z a-z 0-9 - _, canonical tail) base64urldec() decodes
+ * to the same bytes. */
+static inline int jwt_b64dec(const char *in, size_t ilen, char *out, size_t olen)
+{
+#ifdef USE_CURSED_JWT
+	if (likely(jwt_cursed_enabled)) {
+		int r = jwt_cursed_b64url(out, olen, in, ilen);
+
+		if (r >= 0)
+			return r;
+	}
+#endif
+	return base64urldec(in, ilen, out, olen);
+}
+
+#endif /* _HAPROXY_JWT_CURSED_H */
